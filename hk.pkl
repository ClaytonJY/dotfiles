amends "package://github.com/jdx/hk/releases/download/v1.46.0/hk@1.46.0#/Config.pkl"

local fastSteps = new Mapping<String, Step> {
  ["nix-fmt"] {
    check = "nix fmt -- --check ."
  }
}

local fullSteps = new Mapping<String, Step> {
  ...fastSteps
  ["nix-flake-eval"] {
    check = "nix flake check --all-systems --no-build"
    depends = "nix-fmt"
  }
  ["nix-flake-check"] {
    check = "nix flake check"
    depends = "nix-flake-eval"
  }
}

hooks {
  ["pre-commit"] {
    steps = fastSteps
  }

  ["pre-push"] {
    steps = fullSteps
  }

  ["check"] {
    steps = fullSteps
  }
}
